---
// Modal réutilisable pour choisir entre Android et Apple
// Ce modal peut être déclenché par n'importe quel bouton avec data-hs-overlay="#download-modal"
const { id = "download-modal" } = Astro.props;

interface Props {
  id?: string;
}

const defaultAndroidUrl = "/link/app-arm64-v8a-release.apk";
const defaultApplePwaUrl = "https://nutriapp-4ea20.web.app";
---

<!-- Modal de choix de plateforme -->
<div
  id={id}
  class="hs-overlay fixed inset-0 z-[60] hidden h-screen w-screen overflow-y-auto hs-overlay-backdrop-open:bg-neutral-900/90"
  data-lenis-prevent
>
  <div class="flex min-h-full items-center justify-center p-4">
    <div
      class="w-full max-w-md opacity-0 transition-all ease-out hs-overlay-open:opacity-100 hs-overlay-open:duration-500"
    >
      <div
        class="rounded-xl border border-neutral-200 bg-neutral-100 shadow-xs dark:border-neutral-700 dark:bg-neutral-800"
      >
        <div class="p-4 sm:p-7">
          <div class="text-center">
            <div
              class="block text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
              role="heading"
              aria-level="1"
            >
              Choisissez votre plateforme
            </div>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 mb-6">
              Sélectionnez votre appareil pour télécharger Nutriwatt
            </p>
          </div>
          
          <!-- Boutons Android et Apple -->
          <div class="flex flex-col gap-3">
            <!-- Bouton Android -->
            <a
              href={defaultAndroidUrl}
              download
              class="group inline-flex items-center justify-center gap-x-3 rounded-lg border border-transparent bg-[#3A73C1] px-6 py-3 text-sm font-bold text-neutral-50 ring-zinc-500 transition duration-300 hover:bg-[#2D5A96] active:bg-[#2D5A96] focus-visible:ring-3 outline-hidden text-center 2xl:text-base dark:focus:outline-hidden dark:ring-zinc-200"
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M17.523 15.3414c-.157.06-.522.3-.639.491-.117.191-.183.583-.183 1.679 0 1.096.066 1.488.183 1.679.117.191.482.431.639.491.157.06.492.08 1.097.08h.516l.892-1.606c0 0 .613-.861.755-1.173.142-.313.217-.777.217-1.24 0-1.293-.476-2.297-1.427-3.007-.618-.44-1.505-.54-2.05-.54h-.041c0 0-2.504.01-4.221 1.63-.868.82-1.207 1.29-1.426 1.73-.218.44-.336.92-.336 1.401v7.769c0 .481.118.961.336 1.401.219.44.558.91 1.426 1.73 1.717 1.62 4.221 1.63 4.221 1.63h.041c.545 0 1.432-.1 2.05-.54.951-.71 1.427-1.714 1.427-3.007 0-.463-.075-.927-.217-1.24-.142-.313-.755-1.173-.755-1.173l-.892-1.606h-.516c-.605 0-.94.02-1.097.08z"/>
                <path d="M1.737 7.951s-.037.502.092 1.016c.129.513.349.947.349.947l8.252 9.1s.238.36.551.56c.313.2.719.3.719.3h.599s.406-.1.719-.3c.313-.2.551-.56.551-.56l8.252-9.1s.22-.433.349-.947c.129-.513.092-1.016.092-1.016s-.258-.557-.696-1.037c-.437-.48-.866-.78-.866-.78l-7.131-4.78s-.238-.22-.551-.35c-.313-.13-.719-.17-.719-.17h-.599s-.406.04-.719.17c-.313.13-.551.35-.551.35l-7.131 4.78s-.429.3-.866.78c-.437.48-.696 1.037-.696 1.037z"/>
              </svg>
              <span>Télécharger pour Android</span>
            </a>

            <!-- Bouton Apple -->
            <button
              type="button"
              class="group inline-flex items-center justify-center gap-x-3 rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-bold text-neutral-800 ring-zinc-500 transition duration-300 hover:bg-neutral-50 active:bg-neutral-100 focus-visible:ring-3 outline-hidden text-center 2xl:text-base dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:active:bg-neutral-600 dark:ring-zinc-200 download-apple-btn"
              data-download-modal-id={id}
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.08-.4C5.24 17.25 4.71 12.45 9.3 9.32c.78-.65 1.88-.95 2.7-.95.83 0 1.93.3 2.7.95 1.36-1.18 2.71-1.83 4.2-1.65-.91 2.9.56 5.27 1.84 6.95.73.98.68 1.97-.19 2.76zM12.03 3.5c.48 1.34 1.89 3.2 4.05 3.02.06-1.4-.41-2.79-1.19-3.8-.91-1.22-2.35-2.37-4.2-2.22-.05 1.27.34 2.5 1.34 3.58z"
                />
              </svg>
              <span>Télécharger pour Apple</span>
            </button>
          </div>

          <div class="mt-4">
            <button
              type="button"
              data-hs-overlay={`#${id}`}
              class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700"
            >
              Annuler
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal PWA Installation (réutilisé depuis DownloadButtons) -->
<div
  id="pwa-install-modal"
  class="hs-overlay fixed inset-0 z-[60] hidden h-screen w-screen overflow-y-auto hs-overlay-backdrop-open:bg-neutral-900/90"
  data-lenis-prevent
>
  <div class="flex min-h-full items-center justify-center p-4">
    <div
      class="w-full max-w-md opacity-0 transition-all ease-out hs-overlay-open:opacity-100 hs-overlay-open:duration-500"
    >
      <div
        class="rounded-xl border border-neutral-200 bg-neutral-100 shadow-xs dark:border-neutral-700 dark:bg-neutral-800"
      >
        <div class="p-4 sm:p-7">
          <div class="text-center">
            <div
              class="block text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
              role="heading"
              aria-level="1"
            >
              Installer Nutriwatt
            </div>
            <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 text-left">
              Nutriwatt est une application web progressive (PWA). Pour l'installer sur votre iPhone ou iPad :
            </p>
            <ol class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 text-left list-decimal list-inside space-y-2">
              <li>Ouvrez Safari (pas Chrome ou Firefox)</li>
              <li>Appuyez sur le bouton <strong>Partager</strong> <svg class="inline h-4 w-4 align-middle" fill="currentColor" viewBox="0 0 20 20"><path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/></svg> en bas de l'écran</li>
              <li>Sélectionnez <strong>"Sur l'écran d'accueil"</strong></li>
              <li>Appuyez sur <strong>"Ajouter"</strong></li>
            </ol>
            <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 text-left">
              L'application apparaîtra sur votre écran d'accueil comme une application native !
            </p>
          </div>
          <div class="mt-6 flex gap-3">
            <button
              type="button"
              data-hs-overlay="#pwa-install-modal"
              class="flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700"
            >
              Fermer
            </button>
            <a
              href={defaultApplePwaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 rounded-lg bg-[#3A73C1] px-4 py-2 text-center text-sm font-bold text-neutral-50 transition hover:bg-[#2D5A96] active:bg-[#2D5A96] dark:focus:outline-hidden"
            >
              Ouvrir l'application
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Empêcher le scroll du body quand les modals sont ouverts
  document.addEventListener('DOMContentLoaded', function() {
    const modals = ['download-modal', 'pwa-install-modal'];
    
    modals.forEach(modalId => {
      const modal = document.getElementById(modalId);
      if (modal) {
        const observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
              const isOpen = !modal.classList.contains('hidden');
              if (isOpen) {
                document.body.style.overflow = 'hidden';
                document.documentElement.style.overflow = 'hidden';
              } else {
                // Vérifier si d'autres modals sont ouverts
                const anyOpen = modals.some(id => {
                  const m = document.getElementById(id);
                  return m && !m.classList.contains('hidden');
                });
                if (!anyOpen) {
                  document.body.style.overflow = '';
                  document.documentElement.style.overflow = '';
                }
              }
            }
          });
        });
        
        observer.observe(modal, {
          attributes: true,
          attributeFilter: ['class']
        });
        
        // Écouter les clics sur le backdrop pour fermer
        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            modal.classList.add('hidden');
          }
        });
      }
    });
    
    // Gérer le clic sur le bouton Apple pour ouvrir le modal PWA
    document.querySelectorAll('.download-apple-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const downloadModalId = this.getAttribute('data-download-modal-id');
        const downloadModal = document.getElementById(downloadModalId);
        const pwaModal = document.getElementById('pwa-install-modal');
        
        if (downloadModal && pwaModal) {
          // Fermer le modal de choix
          downloadModal.classList.add('hidden');
          // Ouvrir le modal PWA après un court délai
          setTimeout(() => {
            pwaModal.classList.remove('hidden');
          }, 300);
        }
      });
    });
  });
</script>
