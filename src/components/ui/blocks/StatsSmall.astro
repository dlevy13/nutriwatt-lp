---
// Extract the properties from Astro.props
const { title, subTitle } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title: string;
  subTitle: string;
}
---

<!-- Container for title and subtitle -->
<div>
  <p class="text-xl sm:text-2xl md:text-3xl font-bold text-[#3A73C1] dark:text-[#6FAFD6] break-words">{title}</p>
  <p class="mt-1 text-sm sm:text-base text-neutral-600 dark:text-neutral-400">{subTitle}</p>
</div>
