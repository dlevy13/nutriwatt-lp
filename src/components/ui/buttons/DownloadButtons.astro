---
// Composant avec deux boutons de téléchargement : Android et Apple
const { androidUrl, applePwaUrl } = Astro.props;

interface Props {
  androidUrl?: string;
  applePwaUrl?: string;
}

const defaultAndroidUrl = "/link/app-arm64-v8a-release.apk";
const defaultApplePwaUrl = "https://nutriapp-4ea20.web.app";
---

<div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
  <!-- Bouton Android -->
  <a
    href={androidUrl || defaultAndroidUrl}
    download
    class="inline-block transition-all duration-300 hover:opacity-90 hover:scale-105 active:opacity-80 active:scale-100 focus:outline-none focus:ring-2 focus:ring-[#3A73C1] focus:ring-offset-2 rounded-lg drop-shadow-lg hover:drop-shadow-xl download-android-btn"
  >
    <!-- Light mode -->
    <img
      src={`${import.meta.env.BASE_URL}apple-android/GooglePlay/Light/French@2x.png`.replace(/\/+/g, '/')}
      alt="Télécharger sur Google Play"
      class="h-auto w-auto max-h-[60px] dark:hidden"
      loading="lazy"
    />
    <!-- Dark mode -->
    <img
      src={`${import.meta.env.BASE_URL}apple-android/GooglePlay/Dark/French@2x.png`.replace(/\/+/g, '/')}
      alt="Télécharger sur Google Play"
      class="h-auto w-auto max-h-[60px] hidden dark:block"
      loading="lazy"
    />
  </a>

  <!-- Bouton Apple -->
  <button
    type="button"
    data-hs-overlay="#pwa-install-modal"
    class="inline-block transition-all duration-300 hover:opacity-90 hover:scale-105 active:opacity-80 active:scale-100 focus:outline-none focus:ring-2 focus:ring-[#3A73C1] focus:ring-offset-2 rounded-lg drop-shadow-lg hover:drop-shadow-xl download-apple-btn"
  >
    <!-- Light mode -->
    <img
      src={`${import.meta.env.BASE_URL}apple-android/AppStore/Light/French@2x.png`.replace(/\/+/g, '/')}
      alt="Télécharger sur l'App Store"
      class="h-auto w-auto max-h-[60px] dark:hidden"
      loading="lazy"
    />
    <!-- Dark mode -->
    <img
      src={`${import.meta.env.BASE_URL}apple-android/AppStore/Dark/French@2x.png`.replace(/\/+/g, '/')}
      alt="Télécharger sur l'App Store"
      class="h-auto w-auto max-h-[60px] hidden dark:block"
      loading="lazy"
    />
  </button>
</div>

<!-- Modal PWA Installation -->
<div
  id="pwa-install-modal"
  class="hs-overlay fixed inset-0 z-[60] hidden h-screen w-screen overflow-y-auto hs-overlay-backdrop-open:bg-neutral-900/90"
  data-lenis-prevent
>
  <div class="flex min-h-full items-center justify-center p-4">
    <div
      class="w-full max-w-md opacity-0 transition-all ease-out hs-overlay-open:opacity-100 hs-overlay-open:duration-500"
    >
      <div
        class="rounded-xl border border-neutral-200 bg-neutral-100 shadow-xs dark:border-neutral-700 dark:bg-neutral-800"
      >
        <div class="p-4 sm:p-7">
          <div class="text-center">
            <div
              class="block text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4"
              role="heading"
              aria-level="1"
            >
              Installer Nutriwatt
            </div>
            <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 text-left">
              Nutriwatt est une application web progressive (PWA). Pour l'installer sur votre iPhone ou iPad :
            </p>
            <ol class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 text-left list-decimal list-inside space-y-2">
              <li>Ouvrez Safari (pas Chrome ou Firefox)</li>
              <li>Appuyez sur le bouton <strong>Partager</strong> <svg class="inline h-4 w-4 align-middle" fill="currentColor" viewBox="0 0 20 20"><path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/></svg> en bas de l'écran</li>
              <li>Sélectionnez <strong>"Sur l'écran d'accueil"</strong></li>
              <li>Appuyez sur <strong>"Ajouter"</strong></li>
            </ol>
            <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 text-left">
              L'application apparaîtra sur votre écran d'accueil comme une application native !
            </p>
          </div>
          <div class="mt-6 flex gap-3">
            <button
              type="button"
              data-hs-overlay="#pwa-install-modal"
              class="flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700"
            >
              Fermer
            </button>
            <a
              href={applePwaUrl || defaultApplePwaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 rounded-lg bg-[#3A73C1] px-4 py-2 text-center text-sm font-bold text-neutral-50 transition hover:bg-[#2D5A96] active:bg-[#2D5A96] dark:focus:outline-hidden"
            >
              Ouvrir l'application
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Empêcher le scroll du body quand le modal est ouvert
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('pwa-install-modal');
    if (modal) {
      // Observer les changements de classe pour détecter l'ouverture/fermeture
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            const isOpen = !modal.classList.contains('hidden');
            if (isOpen) {
              // Empêcher le scroll
              document.body.style.overflow = 'hidden';
              document.documentElement.style.overflow = 'hidden';
            } else {
              // Réactiver le scroll
              document.body.style.overflow = '';
              document.documentElement.style.overflow = '';
            }
          }
        });
      });
      
      observer.observe(modal, {
        attributes: true,
        attributeFilter: ['class']
      });
      
      // Écouter les clics sur le backdrop pour fermer
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }

    // Tracking des téléchargements via l'utilitaire global window.analytics
    document.querySelectorAll('.download-android-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (window.analytics && typeof window.analytics.trackDownload === 'function') {
          window.analytics.trackDownload('android', { source: 'hero_buttons' });
        }
      });
    });

    document.querySelectorAll('.download-apple-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (window.analytics && typeof window.analytics.trackDownload === 'function') {
          window.analytics.trackDownload('ios', { source: 'hero_buttons' });
        }
      });
    });
  });
</script>
