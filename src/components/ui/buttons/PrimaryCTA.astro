---
import Icon from "@components/ui/icons/Icon.astro";
// Destructure the properties from Astro.props
const { title, url, noArrow, openDownloadModal = false } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
  noArrow?: boolean;
  openDownloadModal?: boolean;
}
// Define CSS classes for styling the button
const baseClasses =
  "group inline-flex items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-sm font-bold text-neutral-50 ring-zinc-500 transition duration-300 focus-visible:ring-3 outline-hidden text-center";
const borderClasses = "border border-transparent";
const bgColorClasses =
  "bg-[#3A73C1] hover:bg-[#2D5A96] active:bg-[#2D5A96] dark:focus:outline-hidden";
const disableClasses = "disabled:pointer-events-none disabled:opacity-50";
const fontSizeClasses = "2xl:text-base";
const ringClasses = "dark:ring-zinc-200";
---

<!-- Link styled as a button, with dynamic title, URL, and optional arrow -->
{openDownloadModal ? (
  <button
    type="button"
    data-hs-overlay="#download-modal"
    class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses}`}
    style="text-align: center;"
  >
    <span class="block text-center w-full">{title}</span>
    {noArrow ? null : <Icon name="arrowRight" />}
  </button>
) : (
  <a
    class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses}`}
    href={url}
    style="text-align: center;"
  >
    <span class="block text-center w-full">{title}</span>
    {noArrow ? null : <Icon name="arrowRight" />}
  </a>
)}
